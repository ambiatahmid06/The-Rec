# Copy this file to .env.local and fill in the values from your Supabase project
# (Dashboard > your project > Connect, or Settings > API Keys).
# Only these two public values belong in the app. Never put the secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
